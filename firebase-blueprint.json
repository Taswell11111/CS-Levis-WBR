{
  "entities": {
    "Report": {
      "title": "WBR Report",
      "description": "Weekly Business Review report containing aggregated metrics.",
      "type": "object",
      "properties": {
        "createdAt": {
          "type": "timestamp",
          "description": "Creation time of the report"
        },
        "authorId": {
          "type": "string",
          "maxLength": 128,
          "description": "UID of the user who generated the report"
        },
        "data": {
          "type": "object",
          "description": "The WBRData object containing all report metrics"
        }
      },
      "required": ["createdAt", "authorId", "data"]
    },
    "Checkpoint": {
      "title": "WBR Checkpoint",
      "description": "Uploaded executive checkpoint report.",
      "type": "object",
      "properties": {
        "updatedAt": {
          "type": "timestamp",
          "description": "Last update time"
        },
        "savedAt": {
          "type": "string",
          "maxLength": 128,
          "description": "ISO timestamp string of when checkpoint was saved"
        },
        "authorId": {
          "type": "string",
          "maxLength": 128,
          "description": "UID of author"
        },
        "data": {
          "type": "object",
          "description": "The WBRData object containing all report metrics"
        },
        "inputs": {
          "type": "object",
          "description": "Input raw data"
        }
      },
      "required": ["updatedAt", "data"]
    },
    "User": {
      "title": "User",
      "description": "Authenticated user",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 256 },
        "createdAt": { "type": "timestamp" }
      }
    }
  },
  "firestore": {
    "reports/{reportId}": {
      "schema": "Report",
      "description": "Stores WBR reports generated by users. Read access by document ID is public for sharing. Create requires authentication."
    },
    "checkpoints/{checkpointId}": {
      "schema": "Checkpoint",
      "description": "Stores active checkpoint reports. Read access by document ID is public for viewers."
    },
    "users/{userId}": {
      "schema": "User",
      "description": "Stores user profiles."
    }
  }
}
